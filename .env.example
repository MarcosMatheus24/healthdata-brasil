# Supabase → Project Settings → Database → Connection string → URI
# Local/ETL: conexão direta (porta 5432). Na Vercel: use o "Transaction pooler" (porta 6543).
# Troque [SENHA] pela senha do banco. NÃO commite o .env.local.
DATABASE_URL=postgresql://postgres:[SENHA]@db.SEU-PROJETO.supabase.co:5432/postgres
